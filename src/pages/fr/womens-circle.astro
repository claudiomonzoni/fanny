---
import Btn from "@components/Btn.astro";
import Encabezados from "@components/Encabezados.astro";
import Prefooter from "@components/Prefooter.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Fanny Vandewiele / Sacred Place"
  description="Women's Circle, Where we can practice and honor the divine feminine in us"
>
  <main>
    <div class="grid contenido fondo-womens">
      <Encabezados
        txtayuda="Cercle de Femmes"
        encabezado="Un espace où nous pouvons explorer et honorer le féminin divin en nous."
      />
    </div>
    <div class="grid contenido">
      <div id="hold">
        <img
          src="/womens-circle-to-hold.webp"
          alt="women's circle, sacred space"
        />
        <div class="der">
          <div class="conte">
            <p>
              … Un lieu sacré pour nous connecter au Cercle, celui qui a toujours existé et existera toujours.
            </p>

            <p>
               … Plonger dans la force de la Terre Mère et honorer chacune d’entre vous, Femmes : votre énergie créatrice, vos parcours uniques et votre féminité.
            </p>

            <p>
               … Il vous suffit de venir telle que vous êtes, avec vos émotions, vos douleurs, votre passé, vos croyances, votre pratique ou son absence.
            </p>
          </div>
        </div>
      </div>
      <div id="whatis">
        <div class="izq">
          <div class="conte">
            <h2>Qu’est-ce qu’un Temple?</h2>
            <p>
              Depuis toujours, des femmes créent des espaces sacrés pour accueillir et transmettre notre sagesse profonde.
            </p>
            <p>
              Le Temple est un lieu pour chacune d’entre nous, où nous pouvons partager notre médecine unique au sein du Cercle ⭕️  créant naturellement un champ énergétique qui soutient notre unité et notre présence commune.
            </p>
          </div>
        </div>
        <div class="der">
          <img
            src="/womens-circle-what-is.webp"
            alt="What is a Women’s Temple"
          />
        </div>
      </div>
    </div>
    <section id="fixed">
      <h2>Un espace pour être, ressentir et se transformer.</h2>
    </section>
    <section class="grid contenido">
      <div id="icons">
        <div class="card">
          <img src="/womens-circle-icon-circle.webp" alt="women's circle" />
          <p>
            <b>Des cercles</b> où l’on peut lâcher prise et ressentir pleinement, bouger librement, exprimer sa vérité et se reconnecter à sa nature instinctive et sauvage.
          </p>
        </div>
        <div class="card">
          <img
            src="/womens-circle-icon-sisterhood.webp"
            alt="women's sisterhood"
          />
          <p>
            <b>La sororité…</b> des groupes où notre voix et nos mouvements sont honorés, où nous chantons, dansons et partageons des pratiques simples et conscientes qui apportent calme, joie et connexion.
          </p>
        </div>
        <div class="card">
          <img src="/womens-circle-icon-spaces.webp" alt="women's spaces" />
          <p>
          <b>Des espaces</b> autour d’une bougie, d’un feu ou en pleine nature.. dans un salon, un centre communautaire, un studio de yoga ou une clairière. Des lieux où le rire, les pleurs, la colère et la joie sont accueillis et célébrés, faisant partie de quelque chose de plus grand que soi.
          </p>
        </div>
        <div class="card">
          <img src="/womens-circle-icon-temple.webp" alt="women's temple" />
          <p>
           <b>Un Temple </b>de Femmes n’est ni une thérapie ni un groupe de soutien, mais un espace sacré pour être présentes, partager et se relier en toute sécurité.
          </p>
        </div>
        <div class="card">
          <img
            src="/womens-circle-icon-awakening.webp"
            alt="women's awakening"
          />
          <p>
           Nous suivons des lignes directrices simples, inspirées du <b>Awakening Women Global Sisterhood Manifesto</b>, qui expliquent comment participer à ces cercles et comment en porter l’esprit dans notre vie quotidienne.
            <br />
            <Btn href='https://awakeningwomen.com/the-sisterhood-manifesto/' text='Découvrez ces principes ici ' className="oscuro" target />
          </p>
        </div>
      </div>
    </section>
    <section>
      <div id="details">
        <div class="conte">
          <h2>Pour qui :</h2>
          <p>Femmes uniquement<br>Âge: 18+</p>
        </div>
        <div class="conte">
          <h2>Langue:</h2>
          <p>Anglais</p>
        </div>
        <div class="conte">
          <h2>À apporter:</h2>
          <ul>
            <li>
              Des vêtements confortables pour bouger, danser, s’asseoir au sol, et qui vous font du bien tout en mettant en valeur votre féminité
            </li>
            <li>Un grand châle</li>
            <li>Des chaussettes chaudes</li>
            <li>Une bouteille d’eau</li>
          </ul>
        </div>
        <div class="conte">
          <h2>Tarifs:</h2>
          <p>
            <b>Temple ouvert:</b> 80 CHF par femme (Twint, espèces ou virement bancaire, à régler à l’avance)
          </p>
          <p>
            <b>Temple fermé <span>(incluant 4 cercles)</span> :</b> 300 CHF par femme (Twint, espèces ou virement bancaire, à régler à l’avance)
          </p>
        </div>
      </div>
    </section>

    <Prefooter
      span="Informations pratiques"
      encabezado="Contactez-moi pour être ajoutée au groupe WhatsApp privé du Cercle de Femmes."
      btntxt="Contactez-moi"
      href="/fr/contact"
    />
  </main>
</Layout>

<style lang="scss">
  @use "/src/styles/variables.scss" as *;

  #hold {
    display: grid;
    grid-template-columns: 1fr 3fr;
    align-items: center;
    background: $muyligero;
    img {
      width: 100%;
    }
    .der {
      display: flex;
      place-content: center;
      .conte {
        width: 60%;
      }
    }
    @include cel {
      grid-template-columns: 1fr;
      .der {
        order: -1;
        padding: $margen 0;
        .conte {
          width: 70%;
        }
      }
    }
    @include tableta{
      img{
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .der{
        padding: $margen 0;
      }
    }
  }
  #whatis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    .izq {
      display: flex;
      place-content: center;
      .conte {
        width: 60%;
      }
    }
    @include cel {
      grid-template-columns: 1fr;
      .izq {
        order: -1;
        padding: $margen 0;
        .conte {
          width: 70%;
        }
      }
    }
    @include tableta{
      .der{
        width: 100%;
        height: 100%;
        img{
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
      .izq{
        padding: $margen 0;
      }
    }
  }
#fixed {
  position: relative;
  height: 70vh;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: $margen 0;
  overflow: hidden;

  // Fondo normal (para navegadores que sí soportan fixed)
  background: url(/womens-circle-montains.webp) no-repeat center center;
  background-size: cover;
  background-attachment: fixed;

  // Fallback para iOS
  @supports (-webkit-touch-callout: none) {
    background-attachment: scroll;

    // Usa pseudo-elemento para simular el fondo fijo
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      background: inherit;
      background-attachment: scroll;
      background-size: cover;
      background-position: center;
      z-index: -1;
      transform: translateZ(0);
    }
  }

  h2 {
    color: white;
    font-size: clamp(2rem, 7vw, 3rem);
    text-align: center;
    width: 60%;
    font-family: "Montserrat", sans-serif;
    font-weight: lighter;
    z-index: 1;
  }

  @include cel {
    height: 700px;
    h2 {
      width: 80%;
    }
  }
}

  #icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    gap: 0.4rem;
  }
  .card {
    flex: 1 0 32%;
    display: grid;
    grid-template-columns: 2fr 4fr;
    gap: 1.3rem;
    max-width: 40%;
    align-items: center;
    flex-wrap: wrap;
    margin: $margen-cel 0;
    img {
      flex: 1 0 15%;
      width: 100%;
      max-width: 140px;
      padding: 0.5rem;
      margin: 0 auto;
      @include tableta-land {
        max-width: 100px;
      }
    }
    p {
      text-align: left !important;
      flex: 1 0 85%;
      font-size: 1.2rem;
      text-align: center;
    }
    @include cel {
      grid-template-columns: 1fr;
      flex: 1 0 100%;
      max-width: 100%;
      img {
        flex: 1 0 10%;
      }
      p {
        flex: 1 0 90%;
        max-width: 70%;
        margin: 0 auto;
        text-align: center !important;
      }
    }
  }
  #details {
    background: $primario;
    margin: $margen 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding: $margen;
    .conte {
      flex: 1 0 fit-content;
      max-width: 23%;
    }
    h2,
    p,
    li {
      color: white;
    }
    @include cel {
      flex-direction: column;
     .conte {
        max-width: 100%;
        margin-bottom: 2rem;
      }
    }
  }
</style>
